# All settings are optional; defaults are shown. Prefix is EVEDW_.
EVEDW_DATA_DIR=data
EVEDW_BIND=127.0.0.1:8470
EVEDW_MIN_FREE_GB=20
# Email or similar, sent to ESI in the User-Agent. Set it before running entity refreshes.
EVEDW_ESI_CONTACT=
EVEDW_ESI_DAILY_BUDGET=80000
# Latest value from https://esi.evetech.net/meta/compatibility-dates; re-check the spec when changing.
EVEDW_ESI_COMPATIBILITY_DATE=2026-08-18
# Seconds a refreshed entity stays off the queue unless a new killmail brings it back.
EVEDW_ESI_REFRESH_INTERVAL=2592000
# Killmail days scanned for entity IDs when the refresh queue is populated.
EVEDW_ESI_RECENT_DAYS=7
EVEDW_EVEREF_BASE_URL=https://data.everef.net
EVEDW_ESI_BASE_URL=https://esi.evetech.net
# Seconds
EVEDW_SYNC_INTERVAL_KILLMAILS=21600
EVEDW_SYNC_INTERVAL_MARKET=21600
EVEDW_SWEEP_INTERVAL=604800
# Pause between scheduled entity refresh slices, and requests per slice.
EVEDW_REFRESH_INTERVAL=300
EVEDW_REFRESH_SLICE=1500
EVEDW_EXPORT_INTERVAL=86400
# Seconds between checks for EVE Ref entity backfill archives that are not seeded yet.
EVEDW_SEED_INTERVAL=86400
# Seconds between alliance membership sweeps, and the length of one character affiliation cycle.
EVEDW_ALLIANCE_SWEEP_INTERVAL=86400
EVEDW_AFFILIATION_CYCLE=604800
EVEDW_VERIFY_INTERVAL=604800
# Days back whose file headers are re-checked on every sync; older days only on a sweep.
EVEDW_HEAD_DAYS=120
EVEDW_LOG_LEVEL=INFO
